# --- copy to .env and edit ---

# Public hostname pointing at this server's public IP (A / AAAA record).
HYDRALIS_DOMAIN=api.hydralis.example.com

# Email Let's Encrypt uses for expiry notifications.
HYDRALIS_TLS_EMAIL=admin@hydralis.example.com

# Long random string. Generate with:  openssl rand -hex 48
JWT_SECRET=replace-me

# Comma-separated origins allowed to call the API + open the WebSocket.
# Set to the Firebase Hosting URL once dashboard is live.
CORS_ORIGINS=https://hydralis-app.web.app

# Run the gas sensor simulator. Set to false if real sensors POST readings.
DEMO_MODE=true

# Optional Copernicus credentials for flood features.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
EFAS_WMS_TOKEN=

REQUEST_TIMEOUT_SECONDS=45
